<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Image 1 (from visual2) - Main Gesture Image -->
        <ImageView
            android:id="@+id/ivGesture"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:background="#F0F0F0"
            android:contentDescription="Gesture Image" />

        <!-- Gesture Name (from visual2) -->
        <TextView
            android:id="@+id/tvGestureName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gesture Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- Gesture Description in Filipino/English (from visual2) -->
        <TextView
            android:id="@+id/tvGestureDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IN FILIPINO/ENGLISH"
            android:textSize="12sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>